            <listPerson>
                <person xml:id="PAN01" sex="1">
                    <persName>
                        <roleName>Sir</roleName>
                        <forename>Anthony</forename>
                        <surname>Panizzi</surname>
                        <addName>Antonio Genesio Maria</addName>
                    </persName>
                    <birth when="1797-09-16">
                        <placeName>Italy</placeName>
                    </birth>
                    <death when="1879-04-08"/>
                    <occupation>Italian emigre</occupation>
                    <occupation>reformer</occupation>
                    <occupation>teacher</occupation>
                    <occupation>librarian</occupation>
                    <note type="editorial">
                        <p>Antonio Genesio Maria
    Panizzi went into exile in 1823, came to England, taught in Liverpool, 
    was befriended by William Roscoe, and then through Henry Brougham 
    was made Professor of Italian Literature in University of London in 1828. He
    became librarian of the Britih Museum Library in 1857.</p>
                    </note>
                    <bibl type="printedbook"> Maurizio Isabella, <title>Risorgimento in Exile: Italian Émigrés and the Liberal International in the Post-Napoleonic 
    Era</title> (Oxford: Oxford University Press, 2009) p. 239. </bibl>
