            <listPerson>
                <person xml:id="MCD01" sex="1">
                    <persName>
                        <roleName/>
                        <forename>D.E.</forename>
                        <surname>MacDonnell</surname>
                        <addName/>
                    </persName>
                    <birth when="1000">
                        <placeName/>
                    </birth>
                    <death when="1000"/>
                    <occupation>lawyer</occupation>
                    <occupation>journalist</occupation>
                    <note type="editorial">
                        <p>Successively editor of <title>The Morning Post</title> (probably), <title>The Gazetteer</title>, and <title>The Telegraph</title>, over 1791-6. 
      Founding member of Society of the Friends of the People, April 1792. 
      Almost certainly the same D. E. MacDonnell of the Middle Temple who compiled A Dictionary of the Quotations in Most Frequent Use, 5th ed (1809)</p>
                    </note>
                    <bibl type="printedbook">Robert L. Haig, <title>The Gazetteer 1735-1797</title>, pp. 232-239 and 250-3</bibl>
                    <bibl type="printedbook">L. Werkmeister, <title>The London Daily Press, 1772-1792</title>, pp. 343, 355</bibl>
                    <bibl type="printedbook">L. Werkmeister, <title>A Newspaper History of England, 1792-3</title>, pp. 37, 76, 168, 169</bibl>
                    <bibl type="printedbook">John Taylor, <title>Records of My Life</title>, II, 272-8</bibl>
                </person>
